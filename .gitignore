# dependencies
/node_modules

# Next.js build output
/.next/
/out/

# production build
/build

# env files -- never commit real secrets
.env
.env*.local

# shell history (never intentional)
.bash_history

# local git config (not project config)
.gitconfig

# Sublime workspace (personal, not project) — keep .sublime-project
*.sublime-workspace

# misc
.DS_Store
*.pem
npm-debug.log*
*.zip

# Prisma
/prisma/*.db

# TypeScript incremental build cache
tsconfig.tsbuildinfo

# Local Claude Code settings
.claude/settings.local.json

# Internal docs -- kept local. The repo is public, and these map the whole
# backend (route by route, plus rate-limit thresholds); no reason to publish
# that. Same treatment as the rest of the docs in ../docs/.
#
# README.md is deliberately NOT here: it's the short public-facing one.
/INTERNALS.md
/EDITING_GUIDE.md
