# Postgres connection string. A free tier on Supabase or Neon works fine.
DATABASE_URL="postgresql://user:password@host:5432/venndra"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="run: openssl rand -base64 32"

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# Enable the "Google Calendar API" for the project first.
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Microsoft Entra ID (Azure AD) -> App registrations -> New registration
# API permissions needed: Calendars.ReadWrite, offline_access (delegated)
# Redirect URI: http://localhost:3000/api/auth/callback/azure-ad
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"

# Used to encrypt Apple app-specific passwords at rest. Generate with:
# openssl rand -hex 32
ENCRYPTION_KEY=""

# Optional: for sending booking confirmation emails via Resend
RESEND_API_KEY=""
