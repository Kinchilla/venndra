# Postgres connection string. A free tier on Supabase or Neon works fine.
DATABASE_URL="postgresql://user:password@host:5432/venndra"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="run: openssl rand -base64 32"

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# Enable the "Google Calendar API" for the project first.
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Microsoft Entra ID (Azure AD) -> App registrations -> New registration
# API permissions needed: Calendars.ReadWrite, offline_access (delegated)
# Redirect URI: http://localhost:3000/api/auth/callback/azure-ad
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"

# Used to encrypt Apple app-specific passwords at rest. Generate with:
# openssl rand -hex 32
ENCRYPTION_KEY=""

# Resend, used for magic-link sign-in emails.
#
# Required in production -- without it, sending throws rather than failing
# quietly, since a deployment that can't email sign-in links is one nobody can
# sign into. In development it's optional: leave it blank and the magic-link
# URL is printed to the terminal instead of being sent, which is enough to
# click through locally.
RESEND_API_KEY=""

# From: address for those emails. Must be on a domain verified in Resend, or
# sends are rejected. Defaults to Resend's onboarding@resend.dev sandbox
# sender, which only delivers to your own Resend account address -- fine for
# development, not for real users.
EMAIL_FROM="Venndra <no-reply@yourdomain.com>"

# Twilio, used to text phone-number verification links (Settings -> Profile).
#
# Same optional-in-development shape as RESEND_API_KEY above: leave these blank
# locally and the verification link is printed to the terminal instead of being
# sent, which is enough to click through. In production a missing credential
# hides the phone field rather than offering a confirmation that can never
# arrive.
#
# TWILIO_FROM takes either a Twilio number in E.164 ("+15551234567") or a
# Messaging Service SID ("MG..."). Note that sending to US numbers also
# requires A2P 10DLC brand/campaign registration on the Twilio side, which
# takes days to weeks to clear -- until it does, sends are rejected even with
# valid credentials.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""
